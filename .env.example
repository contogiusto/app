# Copia in .env (non committare). Su Vercel si impostano nelle Environment Variables.
DATABASE_URL=postgresql+psycopg://contogiusto:contogiusto@localhost:5433/contogiusto
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:5173
# Invio email (recupero password dei clienti). Resend: piano gratuito, serve un dominio verificato.
# Senza queste due variabili nessuna email parte e il link si legge nel log del backend.
RESEND_API_KEY=
EMAIL_FROM=Conto Giusto <noreply@tuodominio.it>
